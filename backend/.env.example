# mock: generates simulated runners so the app works out of the box.
# myresult: polls myresult.co.kr's JSON API (verified working, recommended).
# smartchip: polls a raw HTML result page with a generic table parser (unverified, last resort).
DATA_SOURCE=mock

PORT=4000
REFRESH_INTERVAL_MS=30000
MOCK_RUNNER_COUNT=24
ASSUMED_START_PACE_MIN_PER_KM=6

# --- myresult provider settings (DATA_SOURCE=myresult) ---
# Calls GET {MYRESULT_BASE_URL}/api/event/{MYRESULT_EVENT_ID}/player/{bib}
# Find the event id from the event's overview page URL, e.g.
# myresult.co.kr/92 -> 2024 JTBC Seoul Marathon, myresult.co.kr/133 -> 2025.
MYRESULT_EVENT_ID=92
MYRESULT_BASE_URL=https://www.myresult.co.kr
# "bib:name" pairs, comma-separated. Name is optional (the API also returns it).
# This is a real example bib from a 2024 JTBC Seoul Marathon finisher.
MYRESULT_BIBS=18915:최유종
MYRESULT_REQUEST_DELAY_MS=800

# --- smartchip provider settings (DATA_SOURCE=smartchip) ---
# Generic fallback for sites that only render plain HTML tables (no JSON
# API found yet). See src/providers/smartchipProvider.js for how to point
# it at exact CSS selectors if the built-in heuristic parser doesn't work.
SMARTCHIP_URL_TEMPLATE=https://smartchip.co.kr/Search_Ballyno.html?usedata={bib}
SMARTCHIP_BIBS=10321:홍길동,10322:김철수
# SMARTCHIP_SELECTORS={"row":"table.record-table tr","km":".km-label","time":".record-time","name":".runner-name"}
SMARTCHIP_REQUEST_DELAY_MS=1500

# Set to any value to dump fetched HTML into backend/.debug-html/ for
# selector debugging (smartchip provider only).
# DEBUG_HTML=1
