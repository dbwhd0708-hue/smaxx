# mock: generates simulated runners so the app works out of the box.
# smartchip: polls a real result page (see src/providers/smartchipProvider.js).
DATA_SOURCE=mock

PORT=4000
REFRESH_INTERVAL_MS=15000
MOCK_RUNNER_COUNT=24
ASSUMED_START_PACE_MIN_PER_KM=6

# --- smartchip provider settings (only used when DATA_SOURCE=smartchip) ---
# URL template with {bib}/{name}/{birth} placeholders filled in per tracked runner.
SMARTCHIP_URL_TEMPLATE=https://smartchip.co.kr/Search_Ballyno.html?usedata={bib}

# "bib:name" pairs, comma-separated. Name is optional (only used for display
# if the page itself doesn't expose the runner's name).
SMARTCHIP_BIBS=10321:홍길동,10322:김철수

# Optional: exact CSS selectors if the generic table parser doesn't find the
# checkpoint table on the real page. Example:
# SMARTCHIP_SELECTORS={"row":"table.record-table tr","km":".km-label","time":".record-time","name":".runner-name"}
# SMARTCHIP_SELECTORS=

SMARTCHIP_REQUEST_DELAY_MS=1500

# Set to any value to dump fetched HTML into backend/.debug-html/ for
# selector debugging.
# DEBUG_HTML=1
